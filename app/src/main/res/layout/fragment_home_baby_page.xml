<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="100dp">

    <ImageView
        android:id="@+id/right"
        android:layout_centerVertical="true"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:src="@drawable/icon_r"/>

    <ImageView
        android:id="@+id/def_baby_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_toRightOf="@+id/right"
        android:layout_centerVertical="true"
        android:src="@drawable/def_baby_icon" />

    <TextView
        android:id="@+id/who_child"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/def_baby_icon"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="30dp"
        android:textSize="18dp"
        android:textColor="@color/text_dark"
        />

    <ImageView
        android:id="@+id/birthday_icon"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_below="@+id/who_child"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="5dp"
        android:layout_toRightOf="@+id/def_baby_icon"
        android:src="@drawable/birthday_icon" />


    <TextView
        android:id="@+id/birthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/birthday_icon"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="45dp"
        android:textSize="16dp"
        android:text="2016/01/01"
        />

    <ImageView
        android:id="@+id/left"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:src="@drawable/icon_l"/>

</RelativeLayout>