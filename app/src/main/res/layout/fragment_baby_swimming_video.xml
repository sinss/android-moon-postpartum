<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_gravity="center">

    <TextureView
        android:id="@+id/video_textureV"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true" />

    <ImageButton
        android:id="@+id/snapshot_btn_imgV"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/icon_snapshot"
        android:layout_marginRight="10dp" />

    <ImageButton
        android:id="@+id/recoding"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/button_recording"
        android:layout_toRightOf="@+id/snapshot_btn_imgV"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="20dp" />

    <ImageButton
        android:id="@+id/extend_btn_imgV"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/icon_full_screen"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="20dp"
        android:layout_alignParentRight="true"
        android:layout_marginRight="20dp" />

</RelativeLayout>