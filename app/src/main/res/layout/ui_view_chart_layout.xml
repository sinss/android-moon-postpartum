<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:id="@+id/ui_chart_layout">


    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:paddingLeft="29dp"
        android:paddingRight="10dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:layout_gravity="bottom">
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#000000"
            android:layout_marginRight="5dp"
            android:id="@+id/chart1_bg" />

        <TextView
            android:text="TextView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="14dp"
            android:gravity="center_vertical"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:id="@+id/chart1_txtV" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#000000"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="5dp"
            android:id="@+id/chart2_bg" />

        <TextView
            android:text="TextView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="14dp"
            android:gravity="center_vertical"
            android:textColor="#000000"
            android:id="@+id/chart2_txtV" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#000000"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="5dp"
            android:id="@+id/chart3_bg" />

        <TextView
            android:text="TextView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="14dp"
            android:gravity="center_vertical"
            android:textColor="#000000"
            android:id="@+id/chart3_txtV" />

        <View
            android:layout_width="12dp"
            android:layout_height="2dp"
            android:background="#000000"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="5dp"
            android:id="@+id/chart4_bg" />

        <TextView
            android:text="TextView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="14dp"
            android:gravity="center_vertical"
            android:textColor="#000000"
            android:id="@+id/chart4_txtV"
            android:textIsSelectable="false" />

        <View
            android:layout_width="12dp"
            android:layout_height="2dp"
            android:background="#000000"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="5dp"
            android:id="@+id/chart5_bg" />

        <TextView
            android:text="TextView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="14dp"
            android:gravity="center_vertical"
            android:textColor="#000000"
            android:id="@+id/chart5_txtV" />

    </LinearLayout>

</LinearLayout>
