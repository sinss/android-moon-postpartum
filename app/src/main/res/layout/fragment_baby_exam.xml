<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/toolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/title"
            style="@style/toolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </androidx.appcompat.widget.Toolbar>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/left_btn"
            android:layout_width="45dp"
            android:layout_height="25dp"
            android:layout_centerVertical="true"
            android:src="@drawable/chevron_left"
            android:background="?android:selectableItemBackground"
            android:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/colorPrimary"
            android:textSize="20dp" />


        <ImageView
            android:id="@+id/right_btn"
            android:layout_width="45dp"
            android:layout_height="25dp"
            android:layout_alignParentRight="true"
            android:background="?android:selectableItemBackground"
            android:layout_centerVertical="true"
            android:src="@drawable/chevron_right"
            android:tint="@color/colorPrimary" />

    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <RelativeLayout
                    android:id="@+id/weight_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/corner_baby_content_bg"
                    android:padding="8dp">


                    <TextView
                        android:id="@+id/weight_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_toRightOf="@+id/weight_icon"
                        android:text="@string/weight"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/weight_exp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentRight="true"
                        android:layout_margin="5dp"
                        android:tint="@color/colorPrimary"
                        android:src="@drawable/exp_icon" />

                    <TextView
                        android:id="@+id/weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ul_ul"
                        android:textColor="@color/colorPrimary"
                        android:layout_below="@+id/weight_title"
                        android:textSize="32dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_below="@+id/weight_title"
                        android:layout_toRightOf="@+id/weight"
                        android:layout_margin="5dp"
                        android:text="@string/weight_unit_g"
                        android:gravity="bottom"
                        android:textColor="@color/colorAccent"
                        android:textSize="14dp" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/temperature_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/corner_baby_content_bg"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/temperature_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/temperature_icon"
                        android:text="@string/temperature"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/temperature_exp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentRight="true"
                        android:layout_margin="5dp"
                        android:tint="@color/colorPrimary"
                        android:src="@drawable/exp_icon" />

                    <TextView
                        android:id="@+id/temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/temperature_title"
                        android:text="@string/ul_ul"
                        android:textColor="@color/colorPrimary"
                        android:textSize="32dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_margin="5dp"
                        android:text="℃"
                        android:gravity="bottom"
                        android:layout_below="@+id/temperature_title"
                        android:layout_toRightOf="@+id/temperature"
                        android:textColor="@color/colorAccent"
                        android:textSize="14dp" />

                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/wc_layout"
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:padding="8dp"
                    android:background="@drawable/corner_baby_content_bg">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/day_wc"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/wc_exp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentRight="true"
                        android:layout_margin="5dp"
                        android:tint="@color/colorPrimary"
                        android:src="@drawable/exp_icon" />

                    <TextView
                        android:id="@+id/small_p_str"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10dp"
                        android:text="@string/small_p"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <TextView
                        android:id="@+id/small_p"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@+id/small_p_str"
                        android:layout_marginLeft="20dp"
                        android:layout_toRightOf="@+id/small_p_str"
                        android:text="@string/ul_ul"
                        android:textColor="@color/colorPrimary"
                        android:textSize="32dp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/big_p_str"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/small_p_str"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/big_p"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <TextView
                        android:id="@+id/big_p"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@+id/big_p_str"
                        android:layout_marginLeft="20dp"
                        android:layout_toRightOf="@+id/big_p_str"
                        android:text="@string/ul_ul"
                        android:textColor="@color/colorPrimary"
                        android:textSize="28dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="5dp"
                        android:text="@string/time"
                        android:textColor="@color/colorAccent"
                        android:textSize="14dp" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/milk_layout"
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:padding="8dp"
                    android:background="@drawable/corner_baby_content_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/baby_mom_milk"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/milk_exp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentRight="true"
                        android:layout_margin="5dp"
                        android:tint="@color/colorPrimary"
                        android:src="@drawable/exp_icon" />

                    <TextView
                        android:id="@+id/m_milk_a_str"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="70dp"
                        android:text="@string/m_milk_time_a"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <TextView
                        android:id="@+id/m_milk_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@+id/m_milk_a_str"
                        android:layout_marginLeft="20dp"
                        android:layout_toRightOf="@+id/m_milk_a_str"
                        android:text="@string/ul_ul"
                        android:textColor="@color/colorPrimary"
                        android:textSize="28dp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/m_milk_b_str"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/m_milk_a_str"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/m_milk_time_b"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <TextView
                        android:id="@+id/m_milk_b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@+id/m_milk_b_str"
                        android:layout_marginLeft="20dp"
                        android:layout_toRightOf="@+id/m_milk_b_str"
                        android:text="@string/ul_ul"
                        android:textColor="@color/colorPrimary"
                        android:textSize="28dp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/m_milk_time_img"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_below="@+id/m_milk_b_str"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/check_no" />

                    <TextView
                        android:id="@+id/m_milk_time_str"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/m_milk_b_str"
                        android:layout_marginLeft="40dp"
                        android:layout_marginTop="22dp"
                        android:text="@string/m_milk_time_c"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="5dp"
                        android:text="@string/ml"
                        android:textColor="@color/colorAccent"
                        android:textSize="14dp" />

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <RelativeLayout
                    android:id="@+id/breath_layout"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:padding="8dp"
                    android:background="@drawable/corner_baby_content_bg">


                    <TextView
                        android:id="@+id/breath_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/breath_icon"
                        android:text="@string/breath"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/breath_exp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentRight="true"
                        android:layout_margin="5dp"
                        android:tint="@color/colorPrimary"
                        android:src="@drawable/exp_icon" />

                    <TextView
                        android:id="@+id/breath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ul_ul"
                        android:textColor="@color/colorPrimary"
                        android:layout_below="@+id/breath_title"
                        android:textSize="32dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_margin="5dp"
                        android:text="@string/time_min"
                        android:layout_below="@+id/breath_title"
                        android:layout_toRightOf="@+id/breath"
                        android:gravity="bottom"
                        android:textColor="@color/colorAccent"
                        android:textSize="14dp" />

                </RelativeLayout>



                <RelativeLayout
                    android:id="@+id/heart_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:padding="8dp"
                    android:background="@drawable/corner_baby_content_bg">


                    <TextView
                        android:id="@+id/heart_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/heart"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/heart_exp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentRight="true"
                        android:layout_margin="5dp"
                        android:tint="@color/colorPrimary"
                        android:src="@drawable/exp_icon" />

                    <TextView
                        android:id="@+id/heart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/heart_title"
                        android:text="@string/ul_ul"
                        android:textColor="@color/colorPrimary"
                        android:textSize="32dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_below="@+id/heart_title"
                        android:layout_toRightOf="@+id/heart"
                        android:layout_margin="5dp"
                        android:gravity="bottom"
                        android:text="@string/time_min"
                        android:textColor="@color/colorAccent"
                        android:textSize="14dp" />

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">


                <RelativeLayout
                    android:id="@+id/jaundice_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/corner_baby_content_bg"
                    android:padding="8dp">


                    <TextView
                        android:id="@+id/jaundice_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jaundice"
                        android:textColor="@color/exam_title_text"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/jaundice_exp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentRight="true"
                        android:layout_margin="5dp"
                        android:tint="@color/colorPrimary"
                        android:src="@drawable/exp_icon" />

                    <TextView
                        android:id="@+id/jaundice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/jaundice_title"
                        android:text="@string/ul_ul"
                        android:textColor="@color/colorPrimary"
                        android:textSize="32dp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_below="@+id/jaundice_title"
                        android:layout_toRightOf="@+id/jaundice"
                        android:layout_margin="5dp"
                        android:gravity="bottom"
                        android:text="mg/dl"
                        android:textColor="@color/colorAccent"
                        android:textSize="14dp" />

                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

</LinearLayout>