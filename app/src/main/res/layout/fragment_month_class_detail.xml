

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/backgroundColor"
android:gravity="center"
android:orientation="vertical">

<androidx.appcompat.widget.Toolbar
    android:id="@+id/toolbar"
    style="@style/toolbarStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/left_btn"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_centerVertical="true"
        android:src="@drawable/chevron_left"
        android:visibility="gone"
        android:tint="@color/white" />

    <TextView
        android:id="@+id/title"
        style="@style/toolbarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</androidx.appcompat.widget.Toolbar>


<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    android:orientation="vertical">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <li.com.bobsonclinic.viewer.roundedimageview.RoundedImageView
            android:id="@+id/cover"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerVertical="true"
            android:layout_margin="8dp"
            android:cropToPadding="true"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_c"
            app:riv_corner_radius="6dp" />


        <RelativeLayout
            android:id="@+id/detail_layout2"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="8dp"
            android:layout_toRightOf="@+id/cover"
            android:padding="8dp">

            <TextView
                android:id="@+id/class_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="8dp"
                android:text="title"
                android:textColor="@color/colorPrimary"
                android:textSize="16dp" />


            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:textColor="@color/colorAccent"
                android:textSize="18dp"
                android:visibility="gone" />


            <TextView
                android:id="@+id/class_fee"
                style="@style/feeStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/class_name"
                android:text="免費" />

        </RelativeLayout>

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/detail_layout1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/detail_layout2"
        android:layout_toRightOf="@+id/cover">

        <WebView
            android:id="@+id/class_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/is_check"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/is_check"
            style="@style/buttonStyle"
            android:layout_above="@+id/finish_text"
            android:layout_alignParentRight="true"
            android:background="@drawable/button_enable_bg" />

        <TextView
            android:id="@+id/finish_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/no_check_service"
            android:textColor="@color/red"
            android:textSize="16dp" />

    </RelativeLayout>

</LinearLayout>

</LinearLayout>